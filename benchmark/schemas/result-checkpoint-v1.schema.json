{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://req2test.example/schemas/result-checkpoint-v1.schema.json",
  "title": "Proposed r2t Result Checkpoint v1",
  "description": "Mutable resumability checkpoint proposed by RESULT_TO_V3_LEDGER_SPEC.md; not publication evidence.",
  "oneOf": [
    {"$ref": "#/$defs/runShardCheckpoint"},
    {"$ref": "#/$defs/validationCheckpoint"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex16": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}$"
    },
    "immutableImageId": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\u0000\\r\\n]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "harnessVersion": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"$ref": "#/$defs/nonEmptyString"}
      ]
    },
    "rawReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semanticReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "campaignReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "campaign_digest",
        "semantic_digest"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_digest": {"$ref": "#/$defs/hex16"},
        "semantic_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "campaignAgentRuntimeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "agent_runtime_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "agent_runtime_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "workset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_count", "ordered_item_ids_digest"],
      "properties": {
        "item_count": {"type": "integer", "minimum": 0},
        "ordered_item_ids_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "namedCanonicalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_json"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "value_json": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^/\\u0000\\r\\n]+(?:/[^/\\u0000\\r\\n]+)*$"
    },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "logical_path",
        "path",
        "byte_length",
        "file_sha256"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "logical_path": {"$ref": "#/$defs/relativePath"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "byte_length": {"type": "integer", "minimum": 0},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "adapterInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "public_configuration",
        "secret_inputs",
        "files"
      ],
      "properties": {
        "kind": {
          "enum": [
            "empty",
            "gold",
            "stripped_gold",
            "stub",
            "replay",
            "openai",
            "openhands",
            "aider"
          ]
        },
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "public_configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namedCanonicalValue"}
        },
        "secret_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/inputFile"}
        }
      }
    },
    "resumeOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_resume",
        "stale_running_suffix_adoption",
        "no_resume",
        "retry_failed"
      ],
      "properties": {
        "checkpoint_resume": {"const": true},
        "stale_running_suffix_adoption": {"const": true},
        "no_resume": {"const": false},
        "retry_failed": {"const": false}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "requested_item_ids"],
      "properties": {
        "limit": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1}
          ]
        },
        "requested_item_ids": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/nonEmptyString"}
            }
          ]
        }
      }
    },
    "runInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "selection",
        "effective_run_stamp",
        "adapter",
        "resume"
      ],
      "properties": {
        "schema": {"const": "r2t.run-invocation/v1"},
        "selection": {"$ref": "#/$defs/selection"},
        "effective_run_stamp": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namedCanonicalValue"}
        },
        "adapter": {"$ref": "#/$defs/adapterInvocation"},
        "resume": {"$ref": "#/$defs/resumeOptions"}
      }
    },
    "validationInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "selection", "harness_inputs", "resume"],
      "properties": {
        "schema": {"const": "r2t.validation-invocation/v1"},
        "selection": {"$ref": "#/$defs/selection"},
        "harness_inputs": {"$ref": "#/$defs/validationHarnessInputs"},
        "resume": {"$ref": "#/$defs/resumeOptions"}
      }
    },
    "goldInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "path",
        "byte_length",
        "file_sha256"
      ],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "byte_length": {"type": "integer", "minimum": 0},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "validationHarnessInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_root",
        "feature_inputs",
        "alias_table",
        "autowirable_types"
      ],
      "properties": {
        "gold_root": {"$ref": "#/$defs/absolutePath"},
        "feature_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rawReference"}
        },
        "alias_table": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rawReference"}
          ]
        },
        "autowirable_types": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rawReference"}
          ]
        }
      }
    },
    "harnessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit", "source_sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/harnessVersion"},
        "git_commit": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 40,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            }
          ]
        },
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "docker_execution_authority",
        "docker_execution_binding",
        "docker_daemon_fingerprint_sha256",
        "docker_execution_pool_digest",
        "worker_index",
        "worker_spec_path",
        "worker_spec_sha256",
        "container_image_digest",
        "seed_dir",
        "seed_manifest",
        "seed_key",
        "workspace_seed_digest",
        "database_dump_digest",
        "needs_database",
        "harness",
        "digest"
      ],
      "properties": {
        "schema": {"const": "r2t.worker-runtime-identity/v1"},
        "docker_execution_authority": {"$ref": "#/$defs/semanticReference"},
        "docker_execution_binding": {"$ref": "#/$defs/semanticReference"},
        "docker_daemon_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "docker_execution_pool_digest": {"$ref": "#/$defs/sha256"},
        "worker_index": {"type": "integer", "minimum": 0},
        "worker_spec_path": {"$ref": "#/$defs/absolutePath"},
        "worker_spec_sha256": {"$ref": "#/$defs/sha256"},
        "container_image_digest": {"$ref": "#/$defs/immutableImageId"},
        "seed_dir": {"$ref": "#/$defs/absolutePath"},
        "seed_manifest": {"$ref": "#/$defs/rawReference"},
        "seed_key": {"$ref": "#/$defs/nonEmptyString"},
        "workspace_seed_digest": {"$ref": "#/$defs/sha256"},
        "database_dump_digest": {"const": "no_database"},
        "needs_database": {"const": false},
        "harness": {"$ref": "#/$defs/harnessIdentity"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "identity"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "identity": {"$ref": "#/$defs/runtimeIdentity"}
      }
    },
    "runExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "runtime"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/nonEmptyString"},
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    },
    "validationExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "runtime"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/uuid"},
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    },
    "runPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "campaign",
        "campaign_agent_runtime",
        "release",
        "boundary",
        "profile",
        "protocol",
        "worker_manifest_path",
        "shard_index",
        "shard_count",
        "shard_rule",
        "workset",
        "invocation",
        "invocation_digest",
        "digest"
      ],
      "properties": {
        "schema": {"const": "r2t.run-plan/v1"},
        "campaign": {"$ref": "#/$defs/campaignReference"},
        "campaign_agent_runtime": {
          "$ref": "#/$defs/campaignAgentRuntimeReference"
        },
        "release": {"$ref": "#/$defs/rawReference"},
        "boundary": {"$ref": "#/$defs/rawReference"},
        "profile": {"$ref": "#/$defs/rawReference"},
        "protocol": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rawReference"}
          ]
        },
        "worker_manifest_path": {"$ref": "#/$defs/absolutePath"},
        "shard_index": {"type": "integer", "minimum": 0},
        "shard_count": {"type": "integer", "minimum": 1},
        "shard_rule": {"const": "sha1_item_id_mod_k"},
        "workset": {"$ref": "#/$defs/workset"},
        "invocation": {"$ref": "#/$defs/runInvocation"},
        "invocation_digest": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "validationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "closures",
        "boundary",
        "profile",
        "strip_manifest",
        "gold_inputs",
        "repeats",
        "timeout_seconds",
        "harness_version",
        "workset",
        "invocation",
        "invocation_digest",
        "digest"
      ],
      "properties": {
        "schema": {"const": "r2t.validation-plan/v1"},
        "closures": {"$ref": "#/$defs/rawReference"},
        "boundary": {"$ref": "#/$defs/rawReference"},
        "profile": {"$ref": "#/$defs/rawReference"},
        "strip_manifest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/rawReference"}
          ]
        },
        "gold_inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/goldInput"}
        },
        "repeats": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "harness_version": {"$ref": "#/$defs/harnessVersion"},
        "workset": {"$ref": "#/$defs/workset"},
        "invocation": {"$ref": "#/$defs/validationInvocation"},
        "invocation_digest": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "resultPrefix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byte_length", "row_count", "file_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "byte_length": {"type": "integer", "minimum": 0},
        "row_count": {"type": "integer", "minimum": 0},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runShardCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_kind",
        "state",
        "execution",
        "plan",
        "result_prefix",
        "reason",
        "digest"
      ],
      "properties": {
        "schema": {"const": "r2t.result-checkpoint/v1"},
        "artifact_kind": {"const": "run_shard"},
        "state": {
          "enum": ["draft", "running", "interrupted", "failed"]
        },
        "execution": {"$ref": "#/$defs/runExecution"},
        "plan": {"$ref": "#/$defs/runPlan"},
        "result_prefix": {"$ref": "#/$defs/resultPrefix"},
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        },
        "digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {"enum": ["draft", "running"]}
            },
            "required": ["state"]
          },
          "then": {
            "properties": {"reason": {"type": "null"}}
          },
          "else": {
            "properties": {
              "reason": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "draft"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "result_prefix": {
                "properties": {
                  "byte_length": {"const": 0},
                  "row_count": {"const": 0},
                  "file_sha256": {
                    "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "validationCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_kind",
        "state",
        "execution",
        "plan",
        "result_prefix",
        "reason",
        "digest"
      ],
      "properties": {
        "schema": {"const": "r2t.result-checkpoint/v1"},
        "artifact_kind": {"const": "validation"},
        "state": {
          "enum": ["draft", "running", "interrupted", "failed"]
        },
        "execution": {"$ref": "#/$defs/validationExecution"},
        "plan": {"$ref": "#/$defs/validationPlan"},
        "result_prefix": {"$ref": "#/$defs/resultPrefix"},
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonEmptyString"}
          ]
        },
        "digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {"enum": ["draft", "running"]}
            },
            "required": ["state"]
          },
          "then": {
            "properties": {"reason": {"type": "null"}}
          },
          "else": {
            "properties": {
              "reason": {"$ref": "#/$defs/nonEmptyString"}
            }
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "draft"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "result_prefix": {
                "properties": {
                  "byte_length": {"const": 0},
                  "row_count": {"const": 0},
                  "file_sha256": {
                    "const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
