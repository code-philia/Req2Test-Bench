{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://req2test.example/schemas/result-ledger-v2.schema.json",
 "title": "Proposed r2t Agent Result Ledger v2",
 "description": "Agent-only run_shard and merged_run receipts proposed by RESULT_V3_AGENT_PRODUCER_SPEC.md and amended to admit a no-database identity/v1 or database-backed identity/v2.  A run_shard carries one required agent_producer_evidence reference; a merged_run is closed transitively by its v2 source receipts.",
 "oneOf": [
  {
   "$ref": "#/$defs/runShardReceipt"
  },
  {
   "$ref": "#/$defs/mergedRunReceipt"
  }
 ],
 "$defs": {
  "absolutePath": {
   "type": "string",
   "minLength": 1,
   "pattern": "^/[^\\u0000\\r\\n]*$"
  },
  "adapterInvocation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "name",
    "public_configuration",
    "secret_inputs",
    "files"
   ],
   "properties": {
    "kind": {
     "enum": [
      "aider",
      "openhands"
     ]
    },
    "name": {
     "$ref": "#/$defs/nonEmptyString"
    },
    "public_configuration": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/namedCanonicalValue"
     }
    },
    "secret_inputs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 1,
     "items": {
      "const": "R2T_LLM_API_KEY"
     }
    },
    "files": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/inputFile"
     },
     "minItems": 1
    }
   }
  },
  "campaignAgentRuntimeReference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "file_sha256",
    "agent_runtime_sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "agent_runtime_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "campaignReference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "file_sha256",
    "campaign_digest",
    "semantic_digest"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "campaign_digest": {
     "$ref": "#/$defs/hex16"
    },
    "semantic_digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "harnessIdentity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "version",
    "git_commit",
    "source_sha256"
   ],
   "properties": {
    "version": {
     "$ref": "#/$defs/harnessVersion"
    },
    "git_commit": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "minLength": 40,
       "maxLength": 40,
       "pattern": "^[0-9a-f]{40}$"
      }
     ]
    },
    "source_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "harnessVersion": {
   "oneOf": [
    {
     "type": "integer",
     "minimum": 1
    },
    {
     "$ref": "#/$defs/nonEmptyString"
    }
   ]
  },
  "hex16": {
   "type": "string",
   "minLength": 16,
   "maxLength": 16,
   "pattern": "^[0-9a-f]{16}$"
  },
  "immutableImageId": {
   "type": "string",
   "minLength": 71,
   "maxLength": 71,
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "inputFile": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "role",
    "logical_path",
    "path",
    "byte_length",
    "file_sha256"
   ],
   "properties": {
    "role": {
     "$ref": "#/$defs/nonEmptyString"
    },
    "logical_path": {
     "$ref": "#/$defs/relativePath"
    },
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "byte_length": {
     "type": "integer",
     "minimum": 0
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "merge": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "policy",
    "release",
    "expected_item_count",
    "ordered_item_ids_digest",
    "campaign_semantic_digest",
    "execution_pool_digest"
   ],
   "properties": {
    "policy": {
     "const": "r2t.strict-merge/v1"
    },
    "release": {
     "$ref": "#/$defs/rawReference"
    },
    "expected_item_count": {
     "type": "integer",
     "minimum": 0
    },
    "ordered_item_ids_digest": {
     "$ref": "#/$defs/sha256"
    },
    "campaign_semantic_digest": {
     "$ref": "#/$defs/sha256"
    },
    "execution_pool_digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "mergedRunReceipt": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "artifact_kind",
    "merge",
    "result",
    "campaign_sidecar",
    "source_receipts",
    "digest"
   ],
   "properties": {
    "schema": {
     "const": "r2t.result-ledger/v2"
    },
    "artifact_kind": {
     "const": "merged_run"
    },
    "merge": {
     "$ref": "#/$defs/merge"
    },
    "result": {
     "$ref": "#/$defs/result"
    },
    "campaign_sidecar": {
     "$ref": "#/$defs/rawReference"
    },
    "source_receipts": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/sourceReceipt"
     }
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "namedCanonicalValue": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "value_json"
   ],
   "properties": {
    "name": {
     "$ref": "#/$defs/nonEmptyString"
    },
    "value_json": {
     "$ref": "#/$defs/nonEmptyString"
    }
   }
  },
  "nonEmptyString": {
   "type": "string",
   "minLength": 1,
   "pattern": "\\S"
  },
  "rawReference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "file_sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "relativePath": {
   "type": "string",
   "minLength": 1,
   "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)[^/\\u0000\\r\\n]+(?:/[^/\\u0000\\r\\n]+)*$"
  },
  "result": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "byte_length",
    "row_count",
    "file_sha256"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "byte_length": {
     "type": "integer",
     "minimum": 0
    },
    "row_count": {
     "type": "integer",
     "minimum": 0
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "resumeOptions": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "checkpoint_resume",
    "stale_running_suffix_adoption",
    "no_resume",
    "retry_failed"
   ],
   "properties": {
    "checkpoint_resume": {
     "const": true
    },
    "stale_running_suffix_adoption": {
     "const": true
    },
    "no_resume": {
     "const": false
    },
    "retry_failed": {
     "const": false
    }
   }
  },
  "runExecution": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "attempt_id",
    "runtime"
   ],
   "properties": {
    "attempt_id": {
     "$ref": "#/$defs/nonEmptyString"
    },
    "runtime": {
     "$ref": "#/$defs/runtime"
    }
   }
  },
  "runInvocation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "selection",
    "effective_run_stamp",
    "adapter",
    "resume"
   ],
   "properties": {
    "schema": {
     "const": "r2t.run-invocation/v1"
    },
    "selection": {
     "$ref": "#/$defs/selection"
    },
    "effective_run_stamp": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "$ref": "#/$defs/namedCanonicalValue"
     }
    },
    "adapter": {
     "$ref": "#/$defs/adapterInvocation"
    },
    "resume": {
     "$ref": "#/$defs/resumeOptions"
    }
   }
  },
  "runPlan": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "campaign",
    "campaign_agent_runtime",
    "release",
    "boundary",
    "profile",
    "protocol",
    "worker_manifest_path",
    "shard_index",
    "shard_count",
    "shard_rule",
    "workset",
    "invocation",
    "invocation_digest",
    "digest"
   ],
   "properties": {
    "schema": {
     "const": "r2t.run-plan/v1"
    },
    "campaign": {
     "$ref": "#/$defs/campaignReference"
    },
    "campaign_agent_runtime": {
     "$ref": "#/$defs/campaignAgentRuntimeReference"
    },
    "release": {
     "$ref": "#/$defs/rawReference"
    },
    "boundary": {
     "$ref": "#/$defs/rawReference"
    },
    "profile": {
     "$ref": "#/$defs/rawReference"
    },
    "protocol": {
     "$ref": "#/$defs/rawReference"
    },
    "worker_manifest_path": {
     "$ref": "#/$defs/absolutePath"
    },
    "shard_index": {
     "type": "integer",
     "minimum": 0
    },
    "shard_count": {
     "type": "integer",
     "minimum": 1
    },
    "shard_rule": {
     "enum": ["sha1_item_id_mod_k", "ordered_position_mod_k"]
    },
    "workset": {
     "$ref": "#/$defs/workset"
    },
    "invocation": {
     "$ref": "#/$defs/runInvocation"
    },
    "invocation_digest": {
     "$ref": "#/$defs/sha256"
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "runShardReceipt": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "artifact_kind",
    "execution",
    "plan",
    "result",
    "worker_manifest",
    "agent_producer_evidence",
    "digest"
   ],
   "properties": {
    "schema": {
     "const": "r2t.result-ledger/v2"
    },
    "artifact_kind": {
     "const": "run_shard"
    },
    "execution": {
     "$ref": "#/$defs/runExecution"
    },
    "plan": {
     "$ref": "#/$defs/runPlan"
    },
    "result": {
     "$ref": "#/$defs/result"
    },
    "worker_manifest": {
     "$ref": "#/$defs/rawReference"
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    },
    "agent_producer_evidence": {
     "$ref": "#/$defs/semanticReference"
    }
   }
  },
  "runtime": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "file_sha256",
    "identity"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "identity": {
     "$ref": "#/$defs/runtimeIdentity"
    }
   }
  },
  "runtimeIdentity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema",
    "docker_execution_authority",
    "docker_execution_binding",
    "docker_daemon_fingerprint_sha256",
    "docker_execution_pool_digest",
    "worker_index",
    "worker_spec_path",
    "worker_spec_sha256",
    "container_image_digest",
    "seed_dir",
    "seed_manifest",
    "seed_key",
    "workspace_seed_digest",
    "database_dump_digest",
    "needs_database",
    "harness",
    "digest"
   ],
   "properties": {
    "schema": {
     "enum": [
      "r2t.worker-runtime-identity/v1",
      "r2t.worker-runtime-identity/v2"
     ]
    },
    "docker_execution_authority": {
     "$ref": "#/$defs/semanticReference"
    },
    "docker_execution_binding": {
     "$ref": "#/$defs/semanticReference"
    },
    "docker_daemon_fingerprint_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "docker_execution_pool_digest": {
     "$ref": "#/$defs/sha256"
    },
    "worker_index": {
     "type": "integer",
     "minimum": 0
    },
    "worker_spec_path": {
     "$ref": "#/$defs/absolutePath"
    },
    "worker_spec_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "container_image_digest": {
     "$ref": "#/$defs/immutableImageId"
    },
    "seed_dir": {
     "$ref": "#/$defs/absolutePath"
    },
    "seed_manifest": {
     "$ref": "#/$defs/rawReference"
    },
    "seed_key": {
     "$ref": "#/$defs/nonEmptyString"
    },
    "workspace_seed_digest": {
     "$ref": "#/$defs/sha256"
    },
    "database_dump_digest": {
     "anyOf": [
      {
       "const": "no_database"
      },
      {
       "$ref": "#/$defs/sha256"
      }
     ]
    },
    "needs_database": {
     "type": "boolean"
    },
    "harness": {
     "$ref": "#/$defs/harnessIdentity"
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   },
   "oneOf": [
    {
     "properties": {
      "schema": {
       "const": "r2t.worker-runtime-identity/v1"
      },
      "database_dump_digest": {
       "const": "no_database"
      },
      "needs_database": {
       "const": false
      }
     }
    },
    {
     "properties": {
      "schema": {
       "const": "r2t.worker-runtime-identity/v2"
      },
      "database_dump_digest": {
       "$ref": "#/$defs/sha256"
      },
      "needs_database": {
       "const": true
      }
     }
    }
   ]
  },
  "selection": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "limit",
    "requested_item_ids"
   ],
   "properties": {
    "limit": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "integer",
       "minimum": 1
      }
     ]
    },
    "requested_item_ids": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "array",
       "minItems": 1,
       "uniqueItems": true,
       "items": {
        "$ref": "#/$defs/nonEmptyString"
       }
      }
     ]
    }
   }
  },
  "semanticReference": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "file_sha256",
    "digest"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/absolutePath"
    },
    "file_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "sha256": {
   "type": "string",
   "minLength": 64,
   "maxLength": 64,
   "pattern": "^[0-9a-f]{64}$"
  },
  "sourceReceipt": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "worker_index",
    "receipt_path",
    "receipt_file_sha256",
    "receipt_digest",
    "source_result_file_sha256"
   ],
   "properties": {
    "worker_index": {
     "type": "integer",
     "minimum": 0
    },
    "receipt_path": {
     "$ref": "#/$defs/absolutePath"
    },
    "receipt_file_sha256": {
     "$ref": "#/$defs/sha256"
    },
    "receipt_digest": {
     "$ref": "#/$defs/sha256"
    },
    "source_result_file_sha256": {
     "$ref": "#/$defs/sha256"
    }
   }
  },
  "workset": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "item_count",
    "ordered_item_ids_digest"
   ],
   "properties": {
    "item_count": {
     "type": "integer",
     "minimum": 0
    },
    "ordered_item_ids_digest": {
     "$ref": "#/$defs/sha256"
    }
   }
  }
 }
}
