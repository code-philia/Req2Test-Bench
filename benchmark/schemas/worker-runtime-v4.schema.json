{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://req2test.example/schemas/worker-runtime-v4.schema.json",
  "title": "r2t Worker Runtime v4: PrestaShop memory enforcement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worker",
    "worker_spec_sha256",
    "seed_dir",
    "seed_manifest_sha256",
    "seed_key",
    "workspace_seed_digest",
    "database_dump_digest",
    "container_image_digest",
    "harness_version",
    "needs_database",
    "docker_execution_authority",
    "docker_execution_binding",
    "memory"
  ],
  "properties": {
    "schema": {
      "const": "r2t.worker-runtime/v4"
    },
    "worker": {
      "$ref": "#/$defs/worker"
    },
    "worker_spec_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "seed_dir": {
      "$ref": "#/$defs/absolutePath"
    },
    "seed_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "seed_key": {
      "type": "string",
      "minLength": 1
    },
    "workspace_seed_digest": {
      "$ref": "#/$defs/sha256"
    },
    "database_dump_digest": {
      "anyOf": [
        {
          "const": "no_database"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "container_image_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "harness_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "needs_database": {
      "type": "boolean"
    },
    "docker_execution_authority": {
      "$ref": "#/$defs/evidenceReference"
    },
    "docker_execution_binding": {
      "$ref": "#/$defs/evidenceReference"
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "container_id",
        "configured_memory_bytes",
        "configured_memory_swap_bytes",
        "oom_kill_disabled",
        "effective_memory_bytes",
        "effective_swap_bytes"
      ],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "memory_bytes",
            "swap_bytes"
          ],
          "properties": {
            "schema": {
              "const": "r2t.prestashop-memory-policy/1"
            },
            "memory_bytes": {
              "type": "integer",
              "const": 4294967296
            },
            "swap_bytes": {
              "type": "integer",
              "const": 0
            }
          }
        },
        "container_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configured_memory_bytes": {
          "type": "integer",
          "const": 4294967296
        },
        "configured_memory_swap_bytes": {
          "type": "integer",
          "const": 4294967296
        },
        "oom_kill_disabled": {
          "const": false
        },
        "effective_memory_bytes": {
          "type": "integer",
          "const": 4294967296
        },
        "effective_swap_bytes": {
          "type": "integer",
          "const": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "needs_database": {
            "const": true
          }
        },
        "required": [
          "needs_database"
        ]
      },
      "then": {
        "properties": {
          "database_dump_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "else": {
        "properties": {
          "database_dump_digest": {
            "const": "no_database"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/[^\\u0000\\r\\n]*$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "workspace",
        "container",
        "schema",
        "credential",
        "env_file",
        "workdir",
        "out_path",
        "artifacts_root"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "workspace": {
          "$ref": "#/$defs/absolutePath"
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        },
        "env_file": {
          "$ref": "#/$defs/absolutePath"
        },
        "workdir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "out_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "artifacts_root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    }
  }
}
